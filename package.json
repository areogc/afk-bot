{
  "name": "mc-afk-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dashboard:dev": "cd dashboard && bun install && bun run dev",
    "dashboard:build": "cd dashboard && bun install && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "prismarine-entity": "^2.6.0",
    "bun-types": "^1.4.2"
  }
}